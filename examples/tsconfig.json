{
  "extends": "../tsconfig-base.json",
  "include": ["**/*.ts", "../packages/*/src/**/*.ts"],
  "compilerOptions": {
    // These projects are type-checked, never emitted: `_build` is skipped for
    // every `example-*` package (see `.rmanrc.yml`) and the demos run from
    // source through a TypeScript loader.
    //
    // Without this they emitted, and emitted in the worst possible place. The
    // `include` above does not merely *resolve* `@opra/...` - it pulls every
    // package's sources in as inputs of this project - and with no `outDir`
    // TypeScript writes each output next to its input. One `tsc -b` of a
    // single example left 1461 generated files scattered through the packages'
    // own `src` directories, and the next run compiled further because the
    // `.d.ts` files it had just written made the previously unresolvable
    // imports resolve.
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "paths": {
      "@opra/api-ui": ["../packages/api-ui/src/index.js"],
      "@opra/common": ["../packages/common/src/index.js"],
      "@opra/core": ["../packages/core/src/index.js"],
      "@opra/http": ["../packages/http/src/index.js"],
      "@opra/openapi": ["../packages/openapi/src/index.js"],
      "@opra/socketio": ["../packages/socketio/src/index.js"],
      "@opra/mongodb": ["../packages/mongodb/src/index.js"],
      "@opra/sqb": ["../packages/sqb/src/index.js"],
      "@opra/nestjs": ["../packages/nestjs/src/index.js"],
      "@opra/nestjs-http": ["../packages/nestjs-http/src/index.js"],
      "example-customer-elastic": ["./_lib/customer-elastic/index.js"],
      "example-customer-mongo": ["./_lib/customer-mongo/index.js"],
      "example-customer-sqb": ["./_lib/customer-sqb/index.js"]
    },
    "emitDecoratorMetadata": true
  }
}
