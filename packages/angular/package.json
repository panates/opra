{
  "name": "@opra/angular",
  "version": "1.30.0",
  "description": "Opra internationalization package",
  "author": "Panates",
  "license": "MIT",
  "homepage": "https://www.oprajs.com",
  "scripts": {
    "compile": "tsc",
    "prebuild": "npm run check && npm run lint && npm run clean",
    "build": "ng build",
    "postbuild": "cp ../../LICENSE ./build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "check": "dpdm -T --no-warning --no-tree ./src/public_api.ts",
    "test": "mocha",
    "clean": "npm run clean:src && npm run clean:test && npm run clean:build && npm run clean:cover",
    "clean:src": "ts-cleanup -s src --all",
    "clean:test": "ts-cleanup -s test --all",
    "clean:build": "rimraf build *.tsbuildinfo",
    "clean:cover": "rimraf ../../coverage/angular"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "@browsery/type-is": "^2.0.2-r2",
    "@opra/client": "^1.30.0",
    "rxjs": ">=7.8.0 <8",
    "ts-gems": "^4.0.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@opra/client": "^1.30.0",
    "rxjs": "^7.8.2",
    "core-js": "^3.50.0",
    "cross-fetch": "^4.1.0",
    "expect": "^30.5.1",
    "express": "^5.2.1",
    "ng-packagr": "^22.1.1",
    "superagent": "^10.3.0",
    "supertest": "^7.2.2",
    "zone.js": "^0.16.3"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/opra.git",
    "directory": "packages/angular"
  },
  "engines": {
    "node": ">=16.0",
    "npm": ">=7.0.0"
  },
  "keywords": [
    "opra",
    "client",
    "angular",
    "request",
    "fetch"
  ],
  "publishConfig": {
    "access": "public"
  }
}