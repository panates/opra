{
  "name": "@opra/client",
  "version": "1.32.0",
  "description": "Opra Client package",
  "author": "Panates",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "license": "MIT",
  "homepage": "https://www.oprajs.com",
  "scripts": {
    "test": "mocha"
  },
  "dependencies": {
    "@browsery/http-parser": "^0.5.10-r3",
    "@browsery/multipart-stream": "^2.0.1-r2",
    "@jsopen/objects": "^2.3.4",
    "accepts": "^1.3.8",
    "multipasta": "^0.2.8",
    "tslib": "^2.8.1",
    "uid": "^2.0.2"
  },
  "peerDependencies": {
    "@opra/common": "^1.32.0",
    "rxjs": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@browsery/type-is": "^2.0.2-r2",
    "body-parser": "^2.3.0",
    "expect": "^30.5.2",
    "express": "^5.2.1",
    "ts-gems": "^4.0.4"
  },
  "type": "module",
  "module": "./index.js",
  "browser": "./browser.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "browser": {
        "types": "./index.d.ts",
        "default": "./browser.js"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/opra.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "keywords": [
    "opra",
    "node",
    "client",
    "browser",
    "http",
    "request",
    "fetch"
